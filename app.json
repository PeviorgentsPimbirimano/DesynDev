{
  "expo": {
    "name": "DesynDev",
    "slug": "desyndev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image copy copy copy copy.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "debba722-e2fe-4e70-bf8b-e775bd370494"
      }
    },
    "android": {
      "package": "com.pimbirimano.desyndev"
    }
  }
}
